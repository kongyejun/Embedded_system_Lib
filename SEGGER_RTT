import pylink
import time
import threading
from datetime import datetime
import os

class RTTReader:
    """RTT 数据读取器，支持二进制帧解析和自动重连"""
    def __init__(
        self,
        chip_name="STM32F407VE",
        target_ch=0,
        once_read_size=2048,
        log_file=True,
        read_interval=0.001,
        on_data=None,
    ):
        """
        初始化 RTT 读取器
        参数:
            chip_name: 目标芯片名称
            target_ch: RTT 上行通道号
            once_read_size: 单次读取最大字节数
            log_file: 日志文件路径,True 使用默认路径,False/None 禁用
            read_interval: 读取间隔（秒）
            on_data: 数据回调函数 on_data(text: str)
        """
        self.chip_name = chip_name
        self.target_ch = target_ch
        self.once_read_size = once_read_size
        self.read_interval = read_interval
        self.on_data = on_data
        self._jlink = None
        self._stop_event = threading.Event()
        self._connect_thread = None
        self.konwn_rtt_addr = 0x20001630
        SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
        if log_file is True:
            self.log_file_path = os.path.join(SCRIPT_DIR, "Primitive_data.txt")
        elif isinstance(log_file, str):
            self.log_file_path = os.path.join(SCRIPT_DIR, log_file)
        else:
            self.log_file_path = None

    def start(self):
        """非阻塞启动，后台线程连接 RTT 并持续读取"""
        if self._connect_thread and self._connect_thread.is_alive():
            raise RuntimeError("RTTReader 已在运行")
        self._stop_event.clear()
        self._connect_thread = threading.Thread(target=self._connect_loop, daemon=True)
        self._connect_thread.start()

    def stop(self):
        """停止所有线程并释放资源"""
        self._stop_event.set()
        if self._connect_thread:
            self._connect_thread.join(timeout=5)
            self._connect_thread = None

    @property
    def is_running(self):
        """返回 RTT 读取器是否正在运行"""
        return (
            self._connect_thread is not None
            and self._connect_thread.is_alive()
        )

    def _connect_loop(self):
        """连接线程，负责建立连接，断线后自动重连"""
        self._jlink = pylink.JLink()
        self._jlink.open()
        try:
            self._jlink.connect(chip_name=self.chip_name, speed="auto", verbose=True)
            self._jlink.set_reset_strategy(pylink.JLinkResetStrategyCortexM3.RESETPIN)
            print(f"设备: ({self._jlink.core_name()}) {self.chip_name}")
            print(f"速度: {self._jlink.cpu_speed(silent=True) / 1e6:.2f} MHz/ {self._jlink.speed} kHz")
            while not self._stop_event.is_set():
                print("等待 RTT 控制块...")
                self._jlink.rtt_start()
                time.sleep(1)
                if not self._precise_addr_search():
                    if not self._auto_addr_search():
                        print("[!] 超时: 所有 RAM 区域均未找到 RTT 控制块")
                        print("[!] 设备可能未上电")
                        break
                print("RTT 就绪，启动读取线程")
                read_th = threading.Thread(target=self._read_loop, daemon=True)
                read_th.start()
                read_th.join()
                self._safe_rtt_stop()
                if not self._stop_event.is_set():
                    print("读取线程退出, 1 秒后重连...")
                    time.sleep(1)
        except Exception as e:
            print(f"连接异常: {e}")
        finally:
            self._safe_rtt_stop()
            self._jlink.close()
            self._jlink = None
            print("已断开")

    def _precise_addr_search(self):
        """精确地址搜索，直接指定已知的 RTT 控制块地址"""
        print(f"[*] 阶段1: 直接指定 RTT 地址 0x{self.konwn_rtt_addr:08X}")
        self._jlink.exec_command(f"SetRTTAddr 0x{self.konwn_rtt_addr:08X}")
        self._jlink.rtt_start()
        if self._wait_rtt_ready(timeout=3.0):
            print("[+] RTT 连接成功 (精确地址)")
            return True
        print("[!] 精确地址搜索失败")
        self._jlink.rtt_stop()
        self._jlink.exec_command("SetRTTAddr 0")
        return False

    def _auto_addr_search(self):
        """自动地址搜索，在整个 RAM 区域搜索 RTT 控制块"""
        print(f"[*] 阶段2: 自动搜索阶段")
        self._jlink.rtt_start()
        if self._wait_rtt_ready(timeout=40.0):
            print(f"[+] RTT 连接成功 (自动地址)")
            print(f"[!] 提示: CB 地址已变化，请在 .map 中搜索 '_SEGGER_RTT'")
            print(f"[!] 更新 KNOWN_RTT_ADDR 可加速下次连接")
            return True
        print("[!] 自动地址搜索失败")
        self._jlink.rtt_stop()
        return False

    def _wait_rtt_ready(self, timeout=5.0):
        """轮询等待 RTT 就绪"""
        start = time.time()
        while time.time() - start < timeout:
            try:
                num_up = self._jlink.rtt_get_num_up_buffers()
                if num_up > 0:
                    print(f"RTT 已连接!,通道如下:")
                    num_down = self._jlink.rtt_get_num_down_buffers()
                    for ch in range(num_up):
                        desc = self._jlink.rtt_get_buf_descriptor(ch, True)
                        print(f"  上行[{ch}]: 缓冲区名称={desc.name}, 缓冲区大小={desc.SizeOfBuffer}")
                    for ch in range(num_down):
                        desc = self._jlink.rtt_get_buf_descriptor(ch, False)
                        print(f"  下行[{ch}]: 缓冲区名称={desc.name}, 缓冲区大小={desc.SizeOfBuffer}")
                    return True
            except pylink.JLinkRTTException:
                pass
            time.sleep(0.2)
        return False

    def _read_loop(self):
        """读取线程，持续读取 RTT 数据并解析二进制帧"""
        try:
            if self.log_file_path:
                f = open(self.log_file_path, "a", encoding="utf-8", buffering=8192)
            else:
                f = None
            try:
                if f:
                    f.write(f"\n--- {datetime.now()} 开始记录 ---\n")
                buf = bytearray()
                text_buffer = []
                last_flush_time = time.time()
                flush_interval = 0.5  # 每0.5秒刷新一次文件
                empty_read_count = 0
                while not self._stop_event.is_set():
                    loop_start = time.perf_counter()
                    try:
                        read_start = time.perf_counter()
                        data = self._jlink.rtt_read(self.target_ch, self.once_read_size)
                        read_time = time.perf_counter() - read_start
                    except Exception:
                        print("读取异常, 准备重连...")
                        return
                    parse_time = 0
                    if data:
                        parse_start = time.perf_counter()
                        empty_read_count = 0
                        buf.extend(data)
                        while len(buf) >= 2:
                            head = buf.find(0xAA)
                            if head < 0:
                                buf.clear()
                                break
                            if head > 0:
                                buf = buf[head:]
                            total = buf[1]
                            if total < 3:
                                buf = buf[1:]
                                continue
                            if len(buf) < total:
                                break
                            payload = bytes(buf[2:total])
                            buf = buf[total:]
                            text = self._decode_payload(payload)
                            text_buffer.append(text)
                            if self.on_data:
                                self.on_data(text)
                        parse_time = time.perf_counter() - parse_start
                        # 批量写入文件
                        write_time = 0
                        current_time = time.time()
                        if f and text_buffer and (current_time - last_flush_time >= flush_interval or len(text_buffer) >= 100):
                            write_start = time.perf_counter()
                            f.write("".join(text_buffer))
                            f.flush()
                            text_buffer.clear()
                            last_flush_time = current_time
                            write_time = time.perf_counter() - write_start
                        # 有数据时不sleep，继续快速读取
                        continue
                    else:
                        empty_read_count += 1
                        # 连续多次空读才sleep
                        if empty_read_count >= 3:
                            time.sleep(self.read_interval)
                    loop_time = (time.perf_counter() - loop_start) * 1000
                    # print(f"循环耗时: {loop_time:.3f} ms (读取: {read_time*1000:.3f}, 解析: {parse_time*1000:.3f}, 写入: {write_time*1000:.3f})")
                # 退出前写入剩余数据
                if f and text_buffer:
                    f.write("".join(text_buffer))
                    f.flush()
            finally:
                if f:
                    f.close()
        except Exception as e:
            print(f"线程异常: {e}")
    def _parse_flags(self, payload: bytes, start: int) -> int:
        """解析标志字符串，返回标志字符串结束位置"""
        pos = start
        # 跳过标志字符 (-, 0, +, #, 空格)
        while pos < len(payload) and chr(payload[pos]) in '-0+# ':
            pos += 1
        # 跳过宽度数字
        while pos < len(payload) and ord('0') <= payload[pos] <= ord('9'):
            pos += 1
        # 跳过精度 (. 后跟数字)
        if pos < len(payload) and payload[pos] == ord('.'):
            pos += 1
            while pos < len(payload) and ord('0') <= payload[pos] <= ord('9'):
                pos += 1
        return pos
    def _format_int(self, val: int, spec: str, flags: str) -> str:
        """格式化整数"""
        if spec == 'p':
            width = 8
            i = 0
            while i < len(flags) and not flags[i].isdigit():
                i += 1
            if i < len(flags):
                width = int(flags[i:].split('.')[0] or '8')
            return f"0x{val:0{width}X}"
        try:
            fmt_str = f"%{flags}{spec}"
            return fmt_str % val
        except Exception:
            if spec in 'xX':
                return f"{val:x}" if spec == 'x' else f"{val:X}"
            return str(val)
    def _format_float(self, val: float, flags: str) -> str:
        """格式化浮点数"""
        try:
            fmt_str = f"%{flags}f"
            return fmt_str % val
        except Exception:
            return f"{val:.6f}"
    def _decode_payload(self, payload: bytes) -> str:
        """解析二进制编码的 payload,还原为可读字符串"""
        import struct
        result = []
        i = 0
        while i < len(payload):
            b = payload[i]
            if b != 0x25:
                result.append(chr(b))
                i += 1
                continue
            if i + 1 >= len(payload):
                break
            spec = payload[i + 1]
            if spec == 0x25:
                result.append('%')
                i += 2
                continue
            if spec in (ord('d'), ord('i'), ord('u'), ord('x'), ord('X'), ord('p')):
                flag_start = i + 2
                flag_end = self._parse_flags(payload, flag_start)
                if flag_end + 4 > len(payload):
                    break
                if spec in (ord('d'), ord('i')):
                    val = int.from_bytes(payload[flag_end:flag_end+4], 'big', signed=True)
                else:
                    val = int.from_bytes(payload[flag_end:flag_end+4], 'big', signed=False)
                flags = payload[flag_start:flag_end].decode('ascii', errors='ignore') if flag_end > flag_start else ''
                result.append(self._format_int(val, chr(spec), flags))
                i = flag_end + 4
            elif spec == ord('f'):
                flag_start = i + 2
                flag_end = self._parse_flags(payload, flag_start)
                if flag_end + 8 > len(payload):
                    break
                dval = struct.unpack('>d', payload[flag_end:flag_end+8])[0]
                flags = payload[flag_start:flag_end].decode('ascii', errors='ignore') if flag_end > flag_start else ''
                result.append(self._format_float(dval, flags))
                i = flag_end + 8
            else:
                result.append(chr(b))
                i += 1
        return "".join(result)

    def _safe_rtt_stop(self):
        """安全停止 RTT，忽略异常"""
        try:
            if self._jlink:
                self._jlink.rtt_stop()
        except Exception as e:
            print(f"暂停异常: {e}")
            pass

if __name__ == "__main__":
    reader = RTTReader(
        chip_name="STM32H750VB",
        log_file="rtt_log.txt",
    )
    reader.start()
    while True:
        reader.is_running
        time.sleep(10)
